# ローカル開発: DEV_MODE=1 ならGoogleの設定なしでダミーログインで動く
DEV_MODE=1

# ---- 本番(Vercel)ではすべて必須。値はVercelの Environment Variables に登録し、GitHubには載せない ----
# SECRET_KEY=            python -c "import secrets; print(secrets.token_urlsafe(48))"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DATABASE_URL=          Neon(Vercel Marketplace)のPostgres接続文字列
# APP_BASE_URL=https://<your-app>.vercel.app
# ALLOWED_USERS=me@gmail.com:本人:admin,father@gmail.com:父,mother@gmail.com:母
